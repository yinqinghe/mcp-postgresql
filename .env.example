# PostgreSQL 连接串
# 推荐使用带连接池特性的云 PostgreSQL（如 Neon、Supabase 或自建 PostgreSQL）
# 注意：若使用 Supabase，建议使用连接池端口 6543 (Transaction pooler)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable

# 可选：连接池最大连接数（Serverless 环境建议保持较小，如 3-5）
DB_POOL_MAX=5

# 可选：为公网 MCP 服务设置访问密钥（防止接口被盗刷）
AUTH_TOKEN=your_secure_secret_token_here

# 本地 SSE 启动端口
PORT=8000
